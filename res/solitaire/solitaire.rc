/*
 * Solitaire HD — Win32 resources. Menus, accelerators, dialogs, strings and ids replicate XP
 * Solitaire (docs/xp-reference/solitaire/resources.md) except:
 *   - the extras Game > Redo (Ctrl+Y) and Game > Full Screen (F11, Alt+Enter), and (v1.1) Game > Hint
 *     (H), Game > Finish (F6) and Game > Statistics... (F4) with their dialog, with their status-bar
 *     help strings; the Options dialog's "Extras" group (right of XP's controls, which are unchanged);
 *   - (v1.2) Game > Undo All, Ctrl+Z for Undo (shown on the Undo item; XP's Undo had no key), the C key
 *     on the Deck item, two more Extras;
 *   - (2c) four more Extras (the last two: "Ask before saving or resuming", "Large print cards" with the
 *     Large Print faces 1300 + card of res/common/cards.rc), the Statistics dialog's "High Scores" box, the
 *     five Windows 7-style questions (IDD_NOMOVES .. IDD_SETTINGS) in XP's dialog style;
 *   - no context help ("?" / DS_CONTEXTHELP: we cannot ship sol.hlp);
 *   - Select Card Back shows our 12 backs in buttons of the card's shape (XP stretched its 71 x 96
 *     backs to 33 x 62): 34 x 42 DLU instead of 26 x 42, so the dialog is 230 DLU wide instead of 178;
 *     ids, order, rows, OK / Cancel unchanged;
 *   - string 301 reads "Unable to load ..." (XP: "Unable load"); the strings XP never shows (debug
 *     commands 1005-1009, 202 "Bitmap", 302) and the registry names (code) are left out;
 *   - the icon is our own card box, the version info is ours.
 * Build: windres -I res/solitaire -I res/common -I src -O coff -o solitaire_res.o res/solitaire/solitaire.rc
 * (files are found through the -I directories: this one's, then res/common for the card faces)
 */
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "solitaire.manifest"

IDI_SOLITAIRE ICON "solitaire.ico"

IDR_MENU MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&Deal\t F2",              IDM_DEAL            /* sic: space after the tab */
        MENUITEM SEPARATOR
        MENUITEM "&Undo\tCtrl+Z",           IDM_UNDO            /* (XP: "&Undo", no key) */
        MENUITEM "Undo &All",               IDM_UNDOALL         /* extra (v1.2) */
        MENUITEM "&Redo\tCtrl+Y",           IDM_REDO            /* extra */
        MENUITEM "&Hint\tH",                IDM_HINT            /* extra (v1.1): WM_CHAR 'h' / 'H' */
        MENUITEM "F&inish\tF6",             IDM_FINISH          /* extra (v1.1; "F" = Full Screen) */
        MENUITEM "De&ck...\tC",             IDM_DECK            /* (XP: no key; C is WM_CHAR, v1.2) */
        MENUITEM "&Options...",             IDM_OPTIONS
        MENUITEM "&Statistics...\tF4",      IDM_STATISTICS      /* extra (v1.1) */
        MENUITEM "&Full Screen\tF11",       IDM_FULLSCREEN      /* extra */
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents\t F1",          IDM_HELPCONTENTS    /* sic */
        MENUITEM "&Search for Help on...",  IDM_HELPSEARCH
        MENUITEM "&How to Use Help",        IDM_HELPHOWTO
        MENUITEM SEPARATOR
        MENUITEM "&About Solitaire",        IDM_ABOUT
    END
END

/* XP's two (F1 is not here: it arrives as WM_HELP) plus the extras */
HIDDENACCEL ACCELERATORS
BEGIN
    "2",       IDM_FORCEWIN,   VIRTKEY, SHIFT, ALT, NOINVERT
    VK_F2,     IDM_DEAL,       VIRTKEY
    "Y",       IDM_REDO,       VIRTKEY, CONTROL                 /* extra */
    VK_F11,    IDM_FULLSCREEN, VIRTKEY                          /* extra */
    VK_RETURN, IDM_FULLSCREEN, VIRTKEY, ALT                     /* extra */
    VK_F4,     IDM_STATISTICS, VIRTKEY                          /* extra (v1.1) */
    VK_F6,     IDM_FINISH,     VIRTKEY                          /* extra (v1.1) */
    "Z",       IDM_UNDO,       VIRTKEY, CONTROL                 /* extra (v1.2); repeats while held */
END

/* Dialogs: plain DIALOG templates, "MS Shell Dlg" 8, XP's positions (x/y from the main window's
 * client origin: XP does not centre them) and control styles. */
IDD_DECK DIALOG 11, 12, 230, 112
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Card Back"
FONT 8, "MS Shell Dlg"
BEGIN
    /* owner-drawn: the back inset 3 px in the button (45 x 62 px at 96 DPI), XP's 2-px COLOR_HIGHLIGHT
     * frame around the selected one; id = XP's back id 54..65 */
    CONTROL "", 54, "Button", BS_OWNERDRAW | WS_GROUP | WS_TABSTOP,   8,  4, 34, 42
    CONTROL "", 55, "Button", BS_OWNERDRAW,                          44,  4, 34, 42
    CONTROL "", 60, "Button", BS_OWNERDRAW,                          80,  4, 34, 42
    CONTROL "", 61, "Button", BS_OWNERDRAW,                         116,  4, 34, 42
    CONTROL "", 58, "Button", BS_OWNERDRAW,                         152,  4, 34, 42
    CONTROL "", 59, "Button", BS_OWNERDRAW,                         188,  4, 34, 42
    CONTROL "", 56, "Button", BS_OWNERDRAW,                           8, 48, 34, 42
    CONTROL "", 57, "Button", BS_OWNERDRAW,                          44, 48, 34, 42
    CONTROL "", 62, "Button", BS_OWNERDRAW,                          80, 48, 34, 42
    CONTROL "", 63, "Button", BS_OWNERDRAW,                         116, 48, 34, 42
    CONTROL "", 64, "Button", BS_OWNERDRAW,                         152, 48, 34, 42
    CONTROL "", 65, "Button", BS_OWNERDRAW,                         188, 48, 34, 42
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 70, 94, 40, 14
    CONTROL "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_GROUP | WS_TABSTOP, 120, 94, 40, 14
END

/* Options: XP's 134 x 101 (controls unchanged) plus the "Extras" group to their right: 302 x 192. "Ask before
 * saving or resuming" is indented under "Save game on exit" (enabled only with it). It and "Large print cards"
 * have no mnemonic, as "Enhanced animations": every letter of them is taken (XP's "Out&line dragging" keeps L). */
IDD_OPTIONS DIALOG 50, 31, 302, 192
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "&Draw", IDC_STATIC, "Button", BS_GROUPBOX, 4, 4, 60, 36
    CONTROL "Draw &One", IDC_DRAWONE, "Button", BS_RADIOBUTTON | WS_GROUP | WS_TABSTOP, 8, 13, 52, 12
    CONTROL "Draw &Three", IDC_DRAWTHREE, "Button", BS_RADIOBUTTON, 8, 25, 52, 12
    CONTROL "&Scoring", IDC_STATIC, "Button", BS_GROUPBOX | WS_GROUP, 68, 4, 56, 48
    CONTROL "St&andard", IDC_STANDARD, "Button", BS_RADIOBUTTON | WS_GROUP | WS_TABSTOP, 72, 14, 43, 12
    CONTROL "&Vegas", IDC_VEGAS, "Button", BS_RADIOBUTTON, 72, 26, 36, 12
    CONTROL "&None", IDC_NONE, "Button", BS_RADIOBUTTON, 72, 38, 30, 12
    CONTROL "T&imed game", IDC_TIMED, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 8, 44, 52, 12
    CONTROL "Status &bar", IDC_STATUSBAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 56, 52, 12
    CONTROL "Out&line dragging", IDC_OUTLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 68, 76, 12
    CONTROL "&Cumulative", IDC_CUMULATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 56, 62, 12
    CONTROL "Score", IDC_CUMSCORE, "Static", SS_LEFT | WS_GROUP, 84, 68, 20, 12
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 36, 84, 36, 14
    CONTROL "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_GROUP | WS_TABSTOP, 76, 84, 40, 14
    CONTROL "Extras", IDC_EXTRAS_GROUP, "Button", BS_GROUPBOX | WS_GROUP, 138, 4, 160, 183
    CONTROL "T&urn cards over automatically", IDC_AUTOTURN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 15, 150, 12
    CONTROL "Single clic&k moves a card", IDC_CLICKMOVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 28, 150, 12
    CONTROL "&Finish automatically", IDC_AUTOFINISH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 41, 150, 12
    CONTROL "Deal only winnable &games", IDC_WINNABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 54, 150, 12
    CONTROL "Sav&e game on exit, resume at start", IDC_SAVEGAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 67, 150, 12
    CONTROL "Ask before saving or resuming", IDC_ASKSAVEGAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            152, 80, 142, 12
    CONTROL "&Warn when the game can't be won", IDC_WARNUNWINNABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 93, 150, 12
    CONTROL "Move cards &home automatically", IDC_AUTOHOME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 106, 150, 12
    CONTROL "Click to select, click to &move", IDC_CLICKSELECT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 119, 150, 12
    CONTROL "Tell me when there are no mo&re moves", IDC_NOMOREMOVES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 132, 150, 12
    CONTROL "A&pply option changes to the next game", IDC_NEXTGAMEOPTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 145, 150, 12
    CONTROL "Enhanced animations", IDC_ENHANCEDANIM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 158, 150, 12
    CONTROL "Large print cards", IDC_LARGEPRINT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
            144, 171, 150, 12
END

/* Statistics (extra, v1.1): the mode, then the labels and the values; OK, Reset. 2c: the "High Scores"
 * box to their right (labels, scores / money, dates). */
IDD_STATS DIALOG 50, 31, 344, 158
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Solitaire Statistics"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "&Mode:", IDC_STATIC, "Static", SS_LEFT, 8, 9, 26, 8
    CONTROL "", IDC_STATS_MODE, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, 36, 7, 132, 100
    CONTROL "", IDC_STATIC, "Button", BS_GROUPBOX, 6, 24, 164, 110
    CONTROL "", IDC_STATS_LABELS, "Static", SS_LEFT | SS_NOPREFIX, 14, 35, 100, 66
    CONTROL "", IDC_STATS_VALUES, "Static", SS_RIGHT | SS_NOPREFIX, 112, 35, 48, 66
    CONTROL "High Scores", IDC_STATIC, "Button", BS_GROUPBOX, 176, 24, 162, 110
    CONTROL "", IDC_STATS_TOP_LABELS, "Static", SS_LEFT | SS_NOPREFIX, 184, 35, 64, 97
    CONTROL "", IDC_STATS_TOP_VALUES, "Static", SS_RIGHT | SS_NOPREFIX, 246, 35, 40, 97
    CONTROL "", IDC_STATS_TOP_DATES, "Static", SS_RIGHT | SS_NOPREFIX, 288, 35, 44, 97
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 116, 140, 50, 14
    CONTROL "&Reset", IDC_STATS_RESET, "Button", BS_PUSHBUTTON | WS_TABSTOP, 178, 140, 50, 14
END

/* The Windows 7-style questions (2c, src/solitaire/session.h SOL_ASK_*): Windows 7's wording, XP's look
 * (a message box's question icon and push buttons; no command links). Centred over the window as a
 * message box; button k = answer k, the first the default; Esc gives the safe answer. */
IDD_NOMOVES DIALOG 0, 0, 230, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "No More Moves"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_CHOICE_ICON, "Static", SS_ICON, 8, 8, 21, 20
    CONTROL "There are no more moves. What do you want to do?", IDC_CHOICE_TEXT, "Static", SS_LEFT | SS_NOPREFIX,
            36, 12, 186, 20
    CONTROL "&End Game (counts as a loss)", IDC_CHOICE0, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP,
            36, 38, 186, 14
    CONTROL "&Return to Game (use Undo)", IDC_CHOICE1, "Button", BS_PUSHBUTTON | WS_TABSTOP, 36, 56, 186, 14
END

IDD_NEWGAME DIALOG 0, 0, 230, 98
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Game in Progress"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_CHOICE_ICON, "Static", SS_ICON, 8, 8, 21, 20
    CONTROL "A game is in progress. What do you want to do?", IDC_CHOICE_TEXT, "Static", SS_LEFT | SS_NOPREFIX,
            36, 12, 186, 20
    CONTROL "&Quit and Start a New Game (counts as a loss)", IDC_CHOICE0, "Button",
            BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 36, 38, 186, 14
    CONTROL "&Restart This Game", IDC_CHOICE1, "Button", BS_PUSHBUTTON | WS_TABSTOP, 36, 56, 186, 14
    CONTROL "&Keep Playing", IDC_CHOICE2, "Button", BS_PUSHBUTTON | WS_TABSTOP, 36, 74, 186, 14
END

IDD_EXITGAME DIALOG 0, 0, 230, 98
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Exit Game"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_CHOICE_ICON, "Static", SS_ICON, 8, 8, 21, 20
    CONTROL "A game is in progress. What do you want to do?", IDC_CHOICE_TEXT, "Static", SS_LEFT | SS_NOPREFIX,
            36, 12, 186, 20
    CONTROL "Exit and &Save My Game", IDC_CHOICE0, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP,
            36, 38, 186, 14
    CONTROL "Exit and &Don't Save (counts as a loss)", IDC_CHOICE1, "Button", BS_PUSHBUTTON | WS_TABSTOP,
            36, 56, 186, 14
    CONTROL "Do&n't Exit", IDC_CHOICE2, "Button", BS_PUSHBUTTON | WS_TABSTOP, 36, 74, 186, 14
END

IDD_SAVEDGAME DIALOG 0, 0, 230, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Saved Game Found"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_CHOICE_ICON, "Static", SS_ICON, 8, 8, 21, 20
    CONTROL "You have a saved game. What do you want to do?", IDC_CHOICE_TEXT, "Static", SS_LEFT | SS_NOPREFIX,
            36, 12, 186, 20
    CONTROL "&Continue Saved Game", IDC_CHOICE0, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP,
            36, 38, 186, 14
    CONTROL "&Play New Game (counts as a loss)", IDC_CHOICE1, "Button", BS_PUSHBUTTON | WS_TABSTOP,
            36, 56, 186, 14
END

IDD_SETTINGS DIALOG 0, 0, 230, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Changed Game Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_CHOICE_ICON, "Static", SS_ICON, 8, 8, 21, 20
    CONTROL "The new settings apply to your next game. What do you want to do?", IDC_CHOICE_TEXT, "Static",
            SS_LEFT | SS_NOPREFIX, 36, 12, 186, 20
    CONTROL "&Play New Game (counts as a loss)", IDC_CHOICE0, "Button", BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP,
            36, 38, 186, 14
    CONTROL "&Finish This Game", IDC_CHOICE1, "Button", BS_PUSHBUTTON | WS_TABSTOP, 36, 56, 186, 14
END

STRINGTABLE
BEGIN
    IDS_APPNAME         "Solitaire"
    IDS_SCORE           "Score: "
    IDS_TIME            "Time: "
    IDS_DEALAGAIN       "Deal Again?"
    IDS_HELPFILE        "sol.chm"
    IDS_PRESSESC        "Press Esc or a mouse button to stop..."
    IDS_BONUS           "Bonus: "
    IDS_BYLINE          "Developed for Microsoft by Wes Cherry"
    IDS_ABOUTTEXT       "Resizable HD re-creation of Wes Cherry's XP Solitaire.\r\nCards: Adrian Kennard, cards.revk.uk (CC0)"
    IDS_OUTOFMEMORY     "Out of memory"
    IDS_HELPFAILED      "Unable to load Windows Help application"
    IDS_NODRAGMEM       "Insufficient memory to display card faces when cards move;\n\nselect the Outline dragging box from the Options menu."
    /* status-bar help of the menu items: string id = command id (WM_MENUSELECT) */
    IDM_DEAL            "Deal a new game"
    IDM_UNDO            "Undo last action"
    IDM_DECK            "Choose new deck back"
    IDM_OPTIONS         "Change Solitaire options"
    IDM_EXIT            "Exit Solitaire"
    IDM_FORCEWIN        "Force a win"
    IDM_FULLSCREEN      "Switch between a window and the full screen"
    IDM_REDO            "Redo the last action undone"
    IDM_HINT            "Show a possible move"
    IDM_FINISH          "Move all the cards to the foundations"
    IDM_STATISTICS      "Show the statistics of your games"
    IDM_UNDOALL         "Undo all moves back to the start of the game"
    IDS_MSG_NOHINT      "No hint is available."
    IDS_MSG_UNWINNABLE  "This game can no longer be won. Use Undo to go back."
    IDS_MSG_UNWINNABLE_DEAL "This game cannot be won."
    IDS_MSG_UNDOALL     "Do you want to undo all your moves and return to the start of the game?"
    IDS_MSG_NOUSEFUL    "There are no more useful moves."
    1120                "Draw One, Standard"
    1121                "Draw One, Vegas"
    1122                "Draw One, None"
    1123                "Draw Three, Standard"
    1124                "Draw Three, Vegas"
    1125                "Draw Three, None"
    IDS_STATS_LABELS    "Games played:\nGames won:\nWin percentage:\nCurrent streak:\nLongest winning streak:\nLongest losing streak:\nBest time:\nBest score:"
    IDS_RESETSTATS      "Are you sure you want to delete all statistics?"
    IDS_FINISHBTN       "Finish"
    IDM_ABOUT           "About Solitaire"
    IDM_HELPCONTENTS    "Index of Solitaire help topics"
    IDM_HELPSEARCH      "Search the Help Engine for a specific topic"
    IDM_HELPHOWTO       "Help using help"
END

/* Card faces (400x560 RGBA PNG): the engine's asset ids 1000 + card (res/common/cards.rc) */
#include "cards.rc"

/* Card backs (400x560 RGB PNG; res/solitaire/backs-src: CC0 designs from the RevK generator, edited by
 * make_backs.py): the engine's asset ids 1200 + i = XP's back 54 + i (CE_ASSET_BACK0, render.h) */
1200 RCDATA "backs/54_sky.png"
1201 RCDATA "backs/55_aqua.png"
1202 RCDATA "backs/56_fish.png"
1203 RCDATA "backs/57_frog.png"
1204 RCDATA "backs/58_rose.png"
1205 RCDATA "backs/59_island.png"
1206 RCDATA "backs/60_mosaic.png"
1207 RCDATA "backs/61_orchid.png"
1208 RCDATA "backs/62_night.png"
1209 RCDATA "backs/63_space.png"
1210 RCDATA "backs/64_sunset.png"
1211 RCDATA "backs/65_racing.png"

1 VERSIONINFO
FILEVERSION     1, 2, 0, 0
PRODUCTVERSION  1, 2, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "xp-cards"
            VALUE "FileDescription",  "Solitaire HD"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "SolitaireHD"
            VALUE "OriginalFilename", "SolitaireHD.exe"
            VALUE "ProductName",      "Solitaire HD"
            VALUE "ProductVersion",   "1.2.0.0"
            VALUE "Comments",         "A re-implementation of Solitaire for Windows XP, whose design (by Wes Cherry, Microsoft) it follows; not affiliated with or endorsed by Microsoft. Card faces and backs: SVG playing cards by Adrian Kennard - https://cards.revk.uk (CC0); rank index glyphs from Bitter (SIL Open Font License 1.1)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/*
 * FreeCell HD — Win32 resources. Menus, accelerators, dialogs, strings and ids replicate XP
 * FreeCell (docs/xp-reference/resources.md) except: the extras Game > Redo (Ctrl+Y), Game > Full
 * Screen (F11, Alt+Enter), Game > Hint (H), Game > Finish (F6) and (v1.4) Game > Undo All and Ctrl+Z
 * (Undo), the v1.1/v1.2/v1.4 extras in the Options ("Extras" group), Game Number (won-before line) and Statistics (different games won)
 * dialogs, no context help ("?" / DS_CONTEXTHELP, we cannot ship freecell.hlp), the missing spaces
 * in "lose. There" and "cards. You" are fixed, and the stray '%' in the statistics strings 319-321 is
 * removed (same on-screen text as XP's wsprintf).
 * Build: windres -I res/freecell -I res/common -I src -O coff -o freecell_res.o res/freecell/freecell.rc
 * (files are found through the -I directories: this one's, then res/common for the card faces)
 */
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "freecell.manifest"

IDI_FREECELL ICON "freecell.ico"
DOWNARROW CURSOR "downarrow.cur"

FREEMENU MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New Game\tF2",           IDM_NEWGAME
        MENUITEM "&Select Game\tF3",        IDM_SELECTGAME
        MENUITEM "&Restart Game",           IDM_RESTART, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "S&tatistics...\tF4",      IDM_STATISTICS
        MENUITEM "&Options...\tF5",         IDM_OPTIONS
        MENUITEM "&Full Screen\tF11",       IDM_FULLSCREEN         /* extra ("F" is free; "U" = Undo) */
        MENUITEM SEPARATOR
        MENUITEM "&Undo\tF10",              IDM_UNDO, GRAYED
        MENUITEM "Undo &All",               IDM_UNDOALL, GRAYED    /* extra (v1.4) */
        MENUITEM "&Redo\tCtrl+Y",           IDM_REDO, GRAYED       /* extra */
        MENUITEM "&Hint\tH",                IDM_HINT, GRAYED       /* extra (v1.2): WM_CHAR 'h' / 'H' */
        MENUITEM "F&inish\tF6",             IDM_FINISH, GRAYED     /* extra (v1.2; "F" = Full Screen) */
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents\t F1",          IDM_HELPCONTENTS    /* sic: space after the tab */
        MENUITEM "&Search for Help on...",  IDM_HELPSEARCH
        MENUITEM "&How to Use Help",        IDM_HELPHOWTO
        MENUITEM SEPARATOR
        MENUITEM "&About FreeCell...",      IDM_ABOUT
    END
END

FREEMENU ACCELERATORS
BEGIN
    VK_F1,  IDM_HELPCONTENTS, VIRTKEY
    VK_F1,  IDM_HELPCONTENTS, VIRTKEY, SHIFT
    VK_F2,  IDM_NEWGAME,      VIRTKEY
    VK_F3,  IDM_SELECTGAME,   VIRTKEY
    VK_F4,  IDM_STATISTICS,   VIRTKEY
    VK_F5,  IDM_OPTIONS,      VIRTKEY
    VK_F10, IDM_UNDO,         VIRTKEY
    "Y",    IDM_REDO,         VIRTKEY, CONTROL                  /* extra */
    VK_F10, IDM_CHEAT,        VIRTKEY, SHIFT, CONTROL
    VK_F11, IDM_FULLSCREEN,   VIRTKEY                           /* extra */
    VK_F6,  IDM_FINISH,       VIRTKEY                           /* extra (v1.2) */
    VK_RETURN, IDM_FULLSCREEN, VIRTKEY, ALT                     /* extra */
    "Z",    IDM_UNDO,         VIRTKEY, CONTROL                  /* extra (v1.4); repeats while held */
END

/* Dialogs: plain DIALOG templates, "MS Shell Dlg" 8. The code centres them over the main window,
 * so x/y are XP's values but irrelevant. Control styles are XP's exactly. */
/* GameNum: XP's 120 x 75 plus one line (extra, IDC_WONBEFORE) under the number box: +6 DLU. */
GAMENUM DIALOG 40, 40, 120, 81
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Game Number"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Select a game number", IDC_STATIC, "Static", SS_CENTER, 0, 7, 121, 8
    CONTROL "from 1 to 1000000", IDC_STATIC, "Static", SS_CENTER, 0, 17, 121, 8
    CONTROL "", IDC_GAMENUMBER, "Edit", ES_LEFT | WS_BORDER | WS_TABSTOP, 45, 32, 40, 12
    CONTROL "", IDC_WONBEFORE, "Static", SS_CENTER | SS_NOPREFIX, 0, 47, 121, 8
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 40, 60, 40, 14
END

MOVECOL DIALOG 40, 40, 150, 80
STYLE DS_MODALFRAME | WS_CAPTION
CAPTION "Move to Empty Column..."
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Move &column", IDC_MOVECOLUMN, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 30, 15, 90, 14
    CONTROL "Move &single card", IDC_MOVESINGLE, "Button", BS_PUSHBUTTON | WS_TABSTOP, 30, 35, 90, 14
    CONTROL "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP, 55, 57, 40, 14
END

/* Stats: XP's 150 x 135 plus one line (extra, IDC_STATS_WONDEALS) a blank line below the streaks, like
 * the blocks above it: +16 DLU, the buttons move down with it. */
STATS DIALOG 84, 47, 150, 151
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "FreeCell Statistics"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_STATS_SESSION, "Static", SS_LEFT, 11, 10, 130, 30
    CONTROL "", IDC_STATS_TOTAL, "Static", SS_LEFT, 11, 42, 130, 30
    CONTROL "", IDC_STATS_STREAKS, "Static", SS_LEFT, 11, 74, 130, 40
    CONTROL "", IDC_STATS_WONDEALS, "Static", SS_LEFT | SS_NOPREFIX, 11, 114, 130, 8
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 20, 131, 40, 14
    CONTROL "&Clear", IDC_CLEARSTATS, "Button", BS_PUSHBUTTON | WS_TABSTOP, 90, 131, 40, 14
END

YOULOSE DIALOG 60, 60, 135, 90
STYLE DS_MODALFRAME | WS_CAPTION
CAPTION "Game Over"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Sorry, you lose. There are no more legal moves.\nDo you want to play again?",
            IDC_STATIC, "Static", SS_LEFT, 15, 6, 120, 40
    CONTROL "&Yes", IDYES, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 15, 70, 40, 14
    CONTROL "&No", IDNO, "Button", BS_PUSHBUTTON | WS_TABSTOP, 80, 70, 40, 14
    CONTROL "&Same game", IDC_SAMEGAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 55, 62, 12
END

YOUWIN DIALOG 172, 85, 135, 80
STYLE WS_POPUP | DS_MODALFRAME | WS_CAPTION
CAPTION "Game Over"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Congratulations, you win!\n \nDo you want to play again?",
            IDC_STATIC, "Static", SS_CENTER, 15, 8, 105, 31
    CONTROL "&Yes", IDYES, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 15, 58, 40, 14
    CONTROL "&No", IDNO, "Button", BS_PUSHBUTTON | WS_TABSTOP, 80, 58, 40, 14
    CONTROL "&Select game", IDC_SELECTGAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 43, 63, 12
END

/* Options: XP's 203 x 63 (controls unchanged) plus the "Extras" group below them: +139 DLU. */
IDD_OPTIONS DIALOG 58, 68, 203, 202
STYLE DS_MODALFRAME | DS_3DLOOK | WS_CAPTION | WS_SYSMENU
CAPTION "FreeCell Options"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 148, 9, 50, 14
    CONTROL "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP, 148, 26, 50, 14
    CONTROL "Display &messages on illegal moves", IDC_MESSAGES, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 6, 9, 136, 10
    CONTROL "&Quick play (no animation)", IDC_QUICKPLAY, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 6, 26, 136, 10
    CONTROL "&Double click moves card to free cell", IDC_DBLCLICK, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 6, 43, 136, 10
    CONTROL "Extras", IDC_EXTRAS_GROUP, "Button", BS_GROUPBOX, 6, 58, 192, 138
    CONTROL "Show &time and moves", IDC_SHOWTIME, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 70, 180, 10
    CONTROL "&Standard multi-card moves", IDC_STDSUPERMOVE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 84, 180, 10
    CONTROL "&New Game picks from all 1,000,000 games", IDC_FULLRANGE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 98, 180, 10
    CONTROL "&Warn when the game can't be won", IDC_WARNUNWINNABLE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 112, 180, 10
    CONTROL "Finish &automatically", IDC_AUTOFINISH, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 126, 180, 10
    CONTROL "Single &click moves a card", IDC_SINGLECLICK, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 140, 180, 10
    CONTROL "D&rag and drop cards", IDC_DRAGDROP, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 154, 180, 10
    CONTROL "&Enhanced animations", IDC_ENHANCEDANIM, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 168, 180, 10
    CONTROL "&Large print cards", IDC_LARGEPRINT, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 12, 182, 180, 10
END

STRINGTABLE
BEGIN
    IDS_APPNAME         "FreeCell"
    IDS_BYLINE          "by Jim Horne"
    IDS_TITLE_GAME      "FreeCell Game #%d"
    IDS_OUTOFMEMORY     "Out of memory.  Close other applications and try again."
    IDS_RESIGN          "Do you want to resign this game?"
    IDS_ILLEGAL         "That move is not allowed."
    IDS_NOTENOUGH       "That move requires moving %u cards. You only have enough free space to move %u."
    IDS_CARDSLEFT       "Cards Left: %u"
    IDS_CLEARSTATS      "Are you sure you want to delete all statistics?"
    IDS_1WIN            "1 win"
    IDS_1LOSS           "1 loss"
    IDS_NWINS           "%u wins"
    IDS_NLOSSES         "%u losses"
    IDS_HOWTOPLAY       "How to Play"
    IDS_COMMANDS        "Commands"
    IDS_STREAK          "streak"
    IDS_STYPE           "stype"
    IDS_ABOUTNAME       "FreeCell"
    IDS_STATS_SESSION   "This session\t\t\t%u%%\n\twon:\t\t%u \n\tlost:\t\t%u\n\n"
    IDS_STATS_TOTAL     "Total\t\t\t\t%u%%\n\twon:\t\t%u \n\tlost:\t\t%u\n\n"
    IDS_STATS_STREAKS   "Streaks\n\twins:\t\t%u \n\tlosses:\t\t%u \n\tcurrent:\t\t%s"
    IDS_MOVES           "Moves: %u"
    IDS_TIME            "Time: %s"
    IDS_WONBEFORE       "You have won this game before."
    IDS_WONDEALS        "Different games won: %u"
    IDS_FINISHBTN       "Finish"
END

/* Card faces (400x560 RGBA PNG): the engine's asset ids 1000 + card (res/common/cards.rc) */
#include "cards.rc"

/* King busts (1024x1024 RGBA PNG), ids = FC_ASSET_KING_* in src/freecell/sprites.h */
IDR_KING_RIGHT RCDATA "king/king_right.png"
IDR_KING_LEFT  RCDATA "king/king_left.png"
IDR_KING_SMILE RCDATA "king/king_smile.png"

1 VERSIONINFO
FILEVERSION     1, 4, 0, 0
PRODUCTVERSION  1, 4, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "xp-cards"
            VALUE "FileDescription",  "FreeCell HD"
            VALUE "FileVersion",      "1.4.0.0"
            VALUE "InternalName",     "FreeCellHD"
            VALUE "OriginalFilename", "FreeCellHD.exe"
            VALUE "ProductName",      "FreeCell HD"
            VALUE "ProductVersion",   "1.4.0.0"
            VALUE "Comments",         "A re-implementation of FreeCell for Windows XP, whose design (by Jim Horne, Microsoft) it follows; not affiliated with or endorsed by Microsoft. Card faces: SVG playing cards by Adrian Kennard - https://cards.revk.uk (CC0); rank index glyphs from Bitter (SIL Open Font License 1.1)."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
